# Environment variable reference for the Gadgets Workers.
#
# This file is documentation only — nothing reads it. Copy the lines you need into a root
# `.dev.vars` file (gitignored, `KEY=VALUE` per line) for local development; `pnpm run dev-server`
# loads it into the environment and forwards the relevant vars into each Worker's generated
# `wrangler.dev.jsonc` (see `run-dev-server.js`). For a real deployment the same values are Worker
# vars / secrets: `wrangler secret put <NAME>`, `vars` in the Worker's wrangler.jsonc, or — for
# customer instances — injected by the deploy service from the release manifest.
#
# Everything here is OPTIONAL. With an empty environment the Workshop runs with
# username/password accounts, BYOK models, and no gatekeeper connectors configured.
#
# Vars marked [dev: not forwarded] are read by the Worker but are NOT passed through by
# `run-dev-server.js`; setting them in `.dev.vars` has no effect locally.
#
# KV/R2/DO/service/AI bindings (BLUEPRINTS, BLUEPRINT_CONTENT, AVATARS, LOADER, BROWSER,
# WORKERS_AI, GATEKEEPER_*, PRODUCT_ANALYTICS, ERROR_REPORTER, FRONTEND_ERROR_REPORTER,
# FRONTEND_ERROR_RATE_LIMITER, FLAGS) are not environment variables — they are configured in
# wrangler.jsonc or at deploy time. See packages/workshop-backend/src/env.d.ts.


# =====================================================================================
# workshop-backend — authentication
# =====================================================================================

# Deployment-wide admin usernames, as a JSON array. A JSON binding is preferred, but a string that
# parses as a JSON array is also accepted. Dev forces ["admin"], so this is [dev: not forwarded].
# ADMINS=["alice","bob"]

# Cloudflare Access (SSO). When CF_ACCESS_AUD is set, the deployment authenticates via Access
# instead of username/password. [dev: not forwarded]
# CF_ACCESS_AUD=<access application audience tag>
# CF_ACCESS_ISS=https://<team>.cloudflareaccess.com

# Comma-separated allowlist of gatekeeper vendor ids permitted to drive sign-in. A listed
# gatekeeper must also advertise `providesAuth`. Empty = no gatekeeper sign-in.
# AUTH_GATEKEEPERS=cloudflare,google,github

# "true" hides username/password login + signup, leaving gatekeeper sign-in only. Ignored unless
# AUTH_GATEKEEPERS is non-empty, so a misconfiguration can't lock everyone out.
# DISABLE_PASSWORD_AUTH=true

# Public base URL of the deployment (used to build OAuth redirect URLs, etc.).
# PUBLIC_BASE_URL=http://localhost:8787

# NOTE: authentication config is deliberately env-driven rather than part of the admin panel's
# AdminConfig, so a compromised admin session cannot change it. See AGENTS.md.


# =====================================================================================
# workshop-backend — Cloudflare AI Gateway (platform-managed models)
# =====================================================================================
# When CF_AI_GATEWAY is set, supported providers route through Cloudflare AI Gateway with
# server-managed keys and users don't need their own keys. Inference goes over HTTPS with tokens
# (there is no Workers-binding transport), so the ACCOUNT_ID/API_TOKEN pair is REQUIRED whenever
# CF_AI_GATEWAY is set. Outside gateway mode, Workers AI (provider "cloudflare") is BYOK like
# every other provider. See docs/ai-gateway-billing.md and docs/public-server.md.

# Gateway name — setting this enables gateway mode.
# CF_AI_GATEWAY=your-gateway

# Comma-separated providers to serve through the gateway.
# CF_AI_GATEWAY_PROVIDERS=anthropic,openai,google,cloudflare

# Gateway owner account ID (required with CF_AI_GATEWAY; may differ from the Worker's account).
# CF_AI_GATEWAY_ACCOUNT_ID=<cloudflare account id>

# API token with AI Gateway Run + Read permissions (Run for inference, Read for cost logs).
# CF_AI_GATEWAY_API_TOKEN=<api token>

# Route Workers AI through a different Gateway in the same account. Defaults to CF_AI_GATEWAY.
# CF_AI_GATEWAY_WAI=your-workers-ai-gateway

# "true" sends Workers AI to its plain REST endpoint instead of a named Gateway — no gateway,
# no cost logs. Uses the same account/token pair.
# CF_AI_GATEWAY_WAI_DIRECT=true

# In local dev, start with `pnpm run dev-server -- --use-workers-ai-binding` when using
# CF_AI_GATEWAY*, so webFetch's document-to-Markdown conversion still has a WORKERS_AI binding.


# =====================================================================================
# workshop-backend — OpenRouter gateway
# =====================================================================================
# A peer of the Cloudflare AI Gateway. When OPENROUTER_API_KEY is set, provider "openrouter"
# models are served with this platform key. There is NO BYOK path for OpenRouter — a stored model
# config's apiToken is never used for it.

# Platform key — setting this enables the OpenRouter gateway.
# OPENROUTER_API_KEY=sk-or-v1-...

# Comma-separated model id override, replacing the curated catalog.
# OPENROUTER_MODELS=z-ai/glm-4.7,anthropic/claude-haiku-4.5

# Quick/title model used when OpenRouter is the only active gateway.
# Defaults to anthropic/claude-haiku-4.5.
# OPENROUTER_QUICK_MODEL=anthropic/claude-haiku-4.5

# Defaults to https://openrouter.ai/api/v1.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# =====================================================================================
# workshop-backend — free-tier limits and top-up
# =====================================================================================

# "true" enables the Cloudflare free-tier limit + credits top-up flow. Billing reads a token from
# the user's connected Cloudflare gatekeeper account.
# ENABLE_CLOUDFLARE_LIMITS=true

# Daily free-tier LLM-call limit per user. Defaults to DEFAULT_DAILY_LLM_CALL_LIMIT in code.
# DAILY_LLM_CALL_LIMIT=100

# Minimum connected-account balance in USD required to proceed via BYOK. Defaults to
# MINIMUM_CLOUDFLARE_BALANCE in code.
# MINIMUM_CLOUDFLARE_BALANCE=1

# Truthy makes UI feature flags resolve to their local-development values (DEV_UI_FEATURE_FLAGS),
# bypassing Flagship. Without it, a missing FLAGS binding falls back to DEFAULT_UI_FEATURE_FLAGS.
# [dev: not forwarded]
# DEV=true


# =====================================================================================
# Gatekeeper Workers — OAuth app credentials
# =====================================================================================
# Each gatekeeper Worker reads its own CLIENT_ID / CLIENT_SECRET (and BASE_URL). OAuth app
# credentials live on the gatekeeper Worker, never on the backend.
#
# In local dev, `run-dev-server.js` seeds each gatekeeper's CLIENT_ID/CLIENT_SECRET from the
# prefixed vars below (SHARED_GATEKEEPER_CREDS); both halves of a pair must be set for either to
# be applied. In production these are per-Worker secrets, supplied by the deploy wizard.

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CLOUDFLARE_OAUTH_CLIENT_ID=
# CLOUDFLARE_OAUTH_CLIENT_SECRET=
# SUPABASE_CLIENT_ID=
# SUPABASE_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# CONFLUENCE_CLIENT_ID=
# CONFLUENCE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ZOOMINFO_CLIENT_ID=
# ZOOMINFO_CLIENT_SECRET=

# Gatekeepers with no shared-cred mapping (gatekeeper-linear, gatekeeper-spotify) take CLIENT_ID /
# CLIENT_SECRET directly on their own Worker. Gatekeepers that need no third-party OAuth app at
# all: context, scheduler, homeassistant (users supply their own URL + token in-app), mcp and
# mcp-portal (MCP OAuth uses dynamic client registration).

# Set on each gatekeeper Worker (not via `.dev.vars`): the public URL where that Worker's default
# fetch handler is served, with no trailing slash. Omit for the localhost dev server.
# BASE_URL=https://example.com/gatekeeper/github

# gatekeeper-zoominfo endpoint overrides, set on that Worker. All optional.
# ZOOMINFO_AUTHORIZE_URL=
# ZOOMINFO_TOKEN_URL=
# ZOOMINFO_API_BASE_URL=


# =====================================================================================
# gatekeeper-mcp-portal / gatekeeper-mcp
# =====================================================================================
# Deployment configuration for the admin-configured MCP portal. Unset, readPortalConfig() returns
# null, the connector advertises no resources, and the Workshop hides it — the intended state for a
# deployment with no portal. See packages/gatekeeper-mcp-portal/README.md.
# Forwarded in dev by PASSTHROUGH_GATEKEEPER_VARS in run-dev-server.js.

# The portal's MCP endpoint (Streamable HTTP). The whole configuration of the connector — users
# never type a URL.
# MCP_PORTAL_URL=https://portal.example.com/mcp

# Display name in the connector list and every approval prompt.
# Defaults to "MCP Server Portal (<host>)".
# MCP_PORTAL_NAME=Acme MCP Portal

# "oauth" (default), "none", or "token".
# MCP_PORTAL_AUTH=oauth

# Bearer token, used only with MCP_PORTAL_AUTH=token. A secret.
# MCP_PORTAL_TOKEN=

# "true" lets tool annotations from behind the portal drive auto-approval of writes. Off by
# default: a portal is an aggregator, and those annotations are written by whichever upstream
# server it proxies, not by the administrator who chose the portal. Only set it where the upstreams
# themselves are trusted.
# MCP_PORTAL_TRUST_ANNOTATIONS=true

# "true" permits http:// and private/loopback/link-local/metadata endpoints, for the portal and
# every OAuth URL discovered from it. LOCAL DEVELOPMENT ONLY; pinned to "false" in both Workers'
# wrangler.jsonc. Applies to gatekeeper-mcp as well.
# MCP_ALLOW_INSECURE=true

# Client name presented to MCP servers. Defaults to "Gadgets". Set on the Worker.
# MCP_CLIENT_NAME=Gadgets


# =====================================================================================
# workshop-frontend — build-time (Vite) variables
# =====================================================================================
# Read by Vite at build time, not by any Worker at runtime. Vite loads `.env` files from
# packages/workshop-frontend; the dev server also honours these from the shell.

# Backend host[:port] the frontend connects to. Defaults to localhost:8787. When set without a
# port, run-dev-server.js cannot derive the wrangler port and errors out.
# VITE_BACKEND_HOST=localhost:8787

# "true" builds the Cloudflare Access-mode frontend. The release build sets this itself.
# VITE_CF_ACCESS_MODE=true

# "true" enables trusted frontend error-reporting producers and their hidden source maps.
# Leave unset for deployments without an error Reporter.
# VITE_FRONTEND_ERROR_REPORTING=true

# Dev convenience: auto-create/login a local account on page load.
# VITE_DEV_AUTO_LOGIN=true
# VITE_DEV_USERNAME=dev
# VITE_DEV_PASSWORD=devpassword


# =====================================================================================
# Build / release tooling (not Worker vars)
# =====================================================================================

# Override the directory scanned for output-format blueprints, so a fork can ship its own set
# without touching the submodule. See packages/workshop-backend/format-blueprints/README.md.
# FORMAT_BLUEPRINTS_DIR=

# Required by scripts/release/upload-release.mjs and promote-release.mjs.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# CI-provided; used to derive the default release id (r<CI_PIPELINE_IID>-<sha7>).
# CI_PIPELINE_IID=
# CI_COMMIT_SHA=

# Regenerate the release-manifest golden file after an intentional manifest change:
#   UPDATE_GOLDEN=1 node --test scripts/release-manifest.test.js
# UPDATE_GOLDEN=1
