{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-context",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-02-02",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_irrevocable_stub_storage"
  ],

  // DO classes are reached via ctx.exports; no durable_objects binding needed.
  "migrations": [
    {
      "tag": "v0",
      "new_sqlite_classes": [
        "ContextCollectionDurableObject",
        "UserLibraryDurableObject",
        "LibraryRegistryDurableObject",
        "ContextGatekeeper"
      ]
    }
  ],

  // Public-collections snapshot KV. preview_id preserves existing dev data.
  "kv_namespaces": [
    {
      "binding": "CONTEXT_COLLECTIONS",
      "preview_id": "gadgets-context-collections"
    }
  ],

  // Bounds the public CI ingestion endpoint. The first is keyed per collection, so one noisy
  // repository cannot starve the others; the second is a single key for the whole endpoint, which is
  // what bounds a caller spreading requests across collection ids to mint a budget each.
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "INGEST_GLOBAL_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],

  // Optional: add an Artifacts binding named ARTIFACTS to enable Git-backed collections.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }

}
